{
    name: "fixed-toxopid-starter"
    displayName: "Fixed Toxopid Starter"
    subtitle: "Toxopid builds, mines, and boosts."
    author: "alfdupont"
    repo: "alfdupont/mindustry-starter-mods"
    description: "All three Serpulo core tiers spawn Toxopid. It builds and mines at Poly's speeds, mines ore up to thorium, builds as far as its longest-range weapon can shoot, and boosts at four times its walking speed. With default desktop controls, Left Alt boosts and Left Shift opens Command Mode."
    version: "1.1.0"
    # Headless checks passed on build 146 and the Mindustry 8 development checkout.
    minGameVersion: "146"
    # Uses no extend()/JavaAdapter,
    # so this script mod is marked iOS-compatible.
    iosCompatible: true
}
